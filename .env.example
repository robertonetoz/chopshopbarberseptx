# Optional: text booking requests straight to the shop's phone with Twilio.
# Without these, the booking form opens the visitor's own texting app with the
# request filled in, addressed to the shop's number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number you own, e.g. +19155550100
TWILIO_FROM_NUMBER=
# The shop's cell phone that should receive requests
SHOP_SMS_TO=+19152571446
